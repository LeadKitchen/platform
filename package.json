{
  "name": "@sitruk/root",
  "private": true,
  "engines": {
    "node": ">=24.11.1 <25",
    "bun": ">=1.3.14 <2"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "bun scripts/clean.mjs",
    "clean:workspaces": "turbo run clean",
    "auth:generate": "bun --filter @sitruk/auth generate",
    "db:push": "turbo -F @sitruk/db push",
    "db:generate": "turbo -F @sitruk/db generate",
    "db:migrate": "turbo -F @sitruk/db migrate",
    "db:studio": "turbo -F @sitruk/db studio",
    "dev": "turbo watch dev -F @sitruk/app...",
    "dev:all": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @sitruk/app...",
    "format": "biome format . --skip-parse-errors",
    "format:fix": "biome format --write . --skip-parse-errors",
    "lint": "biome lint . --skip-parse-errors",
    "lint:fix": "biome lint --write . --skip-parse-errors",
    "check": "biome check . --skip-parse-errors",
    "check:fix": "biome check --write . --skip-parse-errors",
    "lint:ws": "sherif",
    "postinstall": "bun lint:ws",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@turbo/gen": "2.10.9",
    "sherif": "1.13.0",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
