# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.
#
# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default matches the local Postgres from `docker-compose.yml`.
# Neon, Supabase and self-hosted Postgres all use the transaction-capable
# `node-postgres` driver in the main application. Prefer a pooled Neon URL.
POSTGRES_URL="postgres://postgres:password@localhost:5432/acme"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# App URL (used in emails and metadata)
APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME="Ситрук"
NEXT_PUBLIC_APP_SHORT_NAME="Acme"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: point the web client at a standalone API server (apps/app-server).
# Leave empty to use the built-in Next.js route handler at /api/orpc.
# NEXT_PUBLIC_API_URL=http://localhost:7000

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 32
# Leave empty here so a weak default is never shipped by accident.
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=

# Preconfigured Google OAuth provider (optional)
# @see https://www.better-auth.com/docs/authentication/google
AUTH_GOOGLE_ID=''
AUTH_GOOGLE_SECRET=''

# -----------------------------------------------------------------------------
# Email (local sandbox via inbucket from docker-compose)
# -----------------------------------------------------------------------------
EMAIL_SANDBOX_ENABLED=true
EMAIL_SANDBOX_HOST=localhost
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# ИИ-модуль деловой игры «Ситуационное руководство»
# -----------------------------------------------------------------------------
# Ключ Claude. Без него модуль работает на mock-провайдере: конвейер и оценка
# по правилам живые, но реплики сотрудника — заглушки.
# -----------------------------------------------------------------------------
# ИИ-модуль: пул провайдеров с переключением
# -----------------------------------------------------------------------------
# Провайдер выбирается автоматически по наличию ключей:
# Anthropic -> OpenAI -> mock. Можно задать явно.
# mock | anthropic | openai | pool  ("pool" = оба сразу, с failover)
# AI_PROVIDER=

# Любой платный OpenAI-совместимый шлюз (прямой OpenAI, реселлер, self-hosted
# vLLM). Реселлеры часто ограничивают доступ по модели на уровне тарифа —
# проверять пробой (probe-models.ts) вместо доверия каталогу /v1/models.
# OPENAI_API_KEY=
# OPENAI_API_KEYS=key1,key2
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5.4-mini

# Сколько кандидат сидит в кулдауне после отказа по лимиту/сети (мс).
# AI_POOL_COOLDOWN_MS=300000

ANTHROPIC_API_KEY=


# Модель и глубина рассуждений (low | medium | high | xhigh | max).
# AI_MODEL=claude-opus-5
# AI_EFFORT=medium

# Вариант конвейера по умолчанию для новых сессий:
# baseline | baseline-judge | rag | graph-rag | skill-rl
# AI_DEFAULT_VARIANT=baseline

# -----------------------------------------------------------------------------
# Storage (S3-compatible — Yandex Cloud Object Storage in production, local
# MinIO from docker-compose for development)
# -----------------------------------------------------------------------------
# Local dev (MinIO):
# AWS_S3_ENDPOINT=http://localhost:9002
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=password
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=files.acme.com
#
# Production (Yandex Cloud Object Storage):
# Static access key from https://console.yandex.cloud → Service accounts →
# your service account → Create new key → Create static access key.
# AWS_S3_ENDPOINT=https://storage.yandexcloud.net
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ru-central1
# AWS_S3_BUCKET=

# -----------------------------------------------------------------------------
# Docling parser service (structure-aware PDF/DOCX extraction for the
# knowledge-base upload pipeline — see services/docling-parser)
# -----------------------------------------------------------------------------
# Unset means the ingestion job falls back to unpdf/mammoth only (plain text,
# no table structure). `docker compose up docling` serves it locally.
# DOCLING_SERVICE_URL=http://localhost:8088
# DOCLING_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# MinerU parser service (second-tier, PDF-only extraction for scans/layout-
# heavy pages Docling struggles with — see services/mineru-parser)
# -----------------------------------------------------------------------------
# Unset means the ingestion job skips straight from Docling to the
# unpdf/mammoth fallback. `docker compose up mineru` serves it locally.
# MINERU_SERVICE_URL=http://localhost:8089
# MINERU_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# Qdrant (org-fusion-rag's vector channel — additive to pgvector, which
# org-rag and the built-in corpus strategies keep using unchanged)
# -----------------------------------------------------------------------------
# Unset means that channel contributes nothing to org-fusion-rag's fusion.
# `docker compose up qdrant` serves it locally.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Neo4j (org-fusion-rag's graph channel — separate from the built-in
# in-memory graph-rag strategy, which needs no database)
# -----------------------------------------------------------------------------
# Unset means that channel contributes nothing to org-fusion-rag's fusion.
# `docker compose up neo4j` serves it locally.
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# -----------------------------------------------------------------------------
# Hatchet (background jobs & workflows, self-hosted on our k3s cluster)
# @see https://docs.hatchet.run/self-hosting
# -----------------------------------------------------------------------------
# API token minted for a tenant in the self-hosted Hatchet dashboard
# (Settings → API Tokens). Encodes the engine's gRPC host, so no separate
# host/port variable is needed.
HATCHET_CLIENT_TOKEN=

# -----------------------------------------------------------------------------
# Inngest (background jobs, workflows, scheduled tasks)
# @see https://www.inngest.com/docs
# -----------------------------------------------------------------------------
# Event key for sending events to Inngest Cloud (leave empty for local dev)
INNGEST_EVENT_KEY=
# Signing key from https://app.inngest.com → project → manage → signing keys
INNGEST_SIGNING_KEY=
# Override the Inngest API base URL (e.g. for self-hosted or Dev Server)
# INNGEST_BASE_URL=http://localhost:8288

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=debug
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Laminar (LLM/agent tracing for @acme/ai calls)
# @see https://laminar.sh/docs
# Project API key from https://laminar.sh/project/<id>/settings/api-keys
# (or generated automatically by `npx lmnr-cli setup`)
LMNR_PROJECT_API_KEY=
# Comma-separated emails allowed to access /admin and admin API procedures.
ADMIN_EMAILS="admin@example.com"

# -----------------------------------------------------------------------------
# Deepgram (server-side speech-to-text for the voice dialog room)
# -----------------------------------------------------------------------------
# Without it, /api/game/dialog/transcribe returns 503 and the voice room falls
# back to its text input.
# @see https://console.deepgram.com
# DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs (server-side premium TTS for the voice dialog room)
# -----------------------------------------------------------------------------
# Without it, /api/game/dialog/speak returns 503 and the voice room falls back
# to the browser's built-in (lower-quality) speech synthesis.
# @see https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# Premade voice IDs used for male/female characters (@see https://elevenlabs.io/app/voice-library).
# ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_VOICE_ID_FEMALE=21m00Tcm4TlvDq8ikWAM
