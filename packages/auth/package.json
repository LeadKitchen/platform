{
  "name": "@acme/auth",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./env.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "generate": "bun --env-file=../../.env x auth generate --config script/auth-cli.ts --output ../db/src/auth-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@acme/config": "workspace:*",
    "@acme/db": "workspace:*",
    "better-auth": "1.7.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "@types/node": "26.5.1",
    "typescript": "7.0.2"
  }
}
